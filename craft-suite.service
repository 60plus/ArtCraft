[Unit]
Description=Craft Suite browser desktop with NVIDIA GPU
Requires=docker.service
After=docker.service network-online.target
Wants=network-online.target

[Service]
Type=oneshot
RemainAfterExit=yes
WorkingDirectory=/opt/artcraft-suite
ExecStartPre=/usr/bin/nvidia-modprobe --modeset
ExecStart=/usr/bin/docker compose up -d
ExecStop=/usr/bin/docker compose stop
TimeoutStartSec=180

[Install]
WantedBy=multi-user.target
