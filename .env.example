ARTCRAFT_IMAGE=60plus/artcraft:latest
BIND_ADDRESS=127.0.0.1
HTTPS_PORT=3443
CUSTOM_USER=craft
PASSWORD=replace-with-a-random-password
PUID=1000
PGID=1000
TZ=Etc/UTC
# Host bind mounts: absolute paths or paths relative to compose.yaml.
APP_DATA_DIR=./data/config
PROJECTS_DIR=./data/projects
# artcraft-launcher opens the app picker; alternatively choose photocraft, effectcraft, etc.
CRAFT_APP=artcraft-launcher
